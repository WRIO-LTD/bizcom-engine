{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false
  },
  "include": ["src/**/*", "jexl.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/tests/**"]
}
